# PostgreSQL (used by docker-compose and app)
POSTGRES_USER=lcloud
POSTGRES_PASSWORD=
POSTGRES_DB=lcloud
# Host port for pgAdmin / local clients — bound to localhost only (container stays on 5432)
POSTGRES_PORT=5432
DATABASE_URL=postgres://lcloud:changeme@postgres:5432/lcloud?sslmode=disable

# Auth
JWT_SECRET=
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7

# Initial admin (seeded on first startup if no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Storage — legacy base path (fallback disk discovery for local dev)
STORAGE_BASE_PATH=./data/storage

# Multi-disk registry (comma-separated paths inside the container)
# Each path must be mounted to a distinct physical disk in docker-compose.yml
STORAGE_DISK_PATHS=/data/disks/ssd,/data/disks/hdd1,/data/disks/hdd2
STORAGE_DISK_LABELS=SSD,HDD 1,HDD 2

# Host paths for docker-compose volume mounts (optional overrides)
DISK_SSD=./data/disks/ssd
DISK_HDD1=./data/disks/hdd1
DISK_HDD2=./data/disks/hdd2

# Upload limits
MAX_UPLOAD_BYTES=104857600

# Server
APP_PORT=8080
GIN_MODE=release

# Plugin binaries directory (inside container: /plugins)
PLUGINS_PATH=./plugins
